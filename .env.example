# ---- Frontend (Vite, build-time; VITE_ prefix is exposed to the browser) ----
# Point the SPA at the backend to use live data. Leave unset for the in-browser mock demo.
# VITE_BACKEND_URL=http://localhost:8787

# ---- Backend (server-side only; NEVER exposed to the browser) ----
# Independent switches:
DATA_SOURCE=mock            # mock | live
ANSWER_ENGINE=mock          # mock | claude

PORT=8787
CORS_ORIGIN=http://localhost:5173
# SERVE_STATIC=1            # set to have the backend also serve the built SPA (dist)

# --- Merge (unified CRM + Ticketing) — required when DATA_SOURCE=live ---
# One Merge account, two categories. MERGE_ACCESS_KEY is your Merge org API key;
# MERGE_ACCOUNT_TOKEN is the linked-account token you get after connecting a customer's
# CRM (and, separately, their help desk) via Merge Link. See SETUP_MERGE.md.
# CRM is the backbone (accounts/ARR/renewals/owner/contacts/opportunities).
# Ticketing is optional and connected separately — if it isn't connected the live
# source degrades to zero tickets and the UI shows "Merge Ticketing: not connected".
# MERGE_ACCESS_KEY=
# MERGE_ACCOUNT_TOKEN=
# MERGE_CRM_BASE_URL=https://api.merge.dev/api/crm/v1
# MERGE_TICKETING_BASE_URL=https://api.merge.dev/api/ticketing/v1

# --- Slack — DEFERRED (not wired in this phase). See SETUP_SLACK.md. ---
# SLACK_BOT_TOKEN=

# --- Gong — optional; live source degrades gracefully without it ---
# GONG_BASE_URL=https://api.gong.io/v2
# GONG_AUTHORIZATION=Basic xxxxx

# --- Claude — required when ANSWER_ENGINE=claude ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# --- Token encryption (for stored integration tokens) ---
# 32-byte base64 key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
